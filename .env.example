# Copy to .env in the repository root (never commit .env).
# Read by backend/app/core/config.py; real environment variables take precedence.

# development | test | production
ENVIRONMENT=development

# Local Homebrew PostgreSQL; tests use vocab_test automatically.
DATABASE_URL=postgresql+psycopg://localhost/vocab_dev

# Only "dev" exists until real authentication (Phase 4). Refused in production.
AUTH_MODE=dev

# Comma-separated origins allowed to call the API from a deployed web app.
# Leave empty in development: Vite proxies /api to the backend.
ALLOWED_ORIGINS=
