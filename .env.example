# Copy to .env in the repository root (never commit .env).
# Read by backend/app/core/config.py; real environment variables take precedence.

# development | test | production
ENVIRONMENT=development

# Local Homebrew PostgreSQL; tests use vocab_test automatically.
DATABASE_URL=postgresql+psycopg://localhost/vocab_dev

# Only "dev" exists until real authentication (Phase 4). Refused in production.
AUTH_MODE=dev

# Comma-separated origins allowed to call the API from a deployed web app.
# Leave empty in development: Vite proxies /api to the backend.
ALLOWED_ORIGINS=

# Drafting decks from a teacher's text (ADR 0018). With a key, DeepSeek drafts the cards; without
# one, development makes placeholder demo cards. Never commit a real key.
DEEPSEEK_API_KEY=
# deepseek-flash (default) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# auto | deepseek | demo
GENERATION_PROVIDER=auto

# --- Production only (AUTH_MODE=jwt, ENVIRONMENT=production; see docs/deploy.md) ---
# Supabase project's auth URL; tokens are verified against its public keys.
AUTH_ISSUER=
# Deletes a learner's login with their account (ADR 0043). It can manage every login: only ever in
# the host's secret store or this ignored file. Required in production.
SUPABASE_SECRET_KEY=
# `make dev-supabase` only: real sign-in locally. The Docker image takes these as build arguments.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Built web app served by the API (set by the Docker image).
WEB_DIST=
# Answer submissions allowed per learner per minute.
ATTEMPTS_PER_MINUTE=120

# Deadline reminders on phones by Web Push (ADR 0031). Make a key pair with
#   cd backend && uv run python -m app.cli vapid-keys
# Without keys there are no reminders. The subject is a contact for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The secret an hourly scheduler sends to POST /api/internal/reminders (unset: no such endpoint).
REMINDERS_TOKEN=
