<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (testing on the emulator against the API on this computer, reached through
     `adb reverse`): plain http to localhost. Release builds keep Android's default: https only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
