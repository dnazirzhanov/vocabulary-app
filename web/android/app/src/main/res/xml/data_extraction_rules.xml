<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes to cloud backup or to a new phone: the server holds the learner's
     data, and a copied device id or sign-in on a second phone would confuse the server's check of
     each device's answers (ADR 0062, 0063). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
