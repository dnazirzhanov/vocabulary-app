ns":[{"id":"library:why-we-forget:1","max":100,"min":20,"q":"What did Hermann Ebbinghaus discover about forgetting?"},{"id":"library:why-we-forget:2","max":100,"min":20,"q":"What is the difference between the spacing effect and the testing effect?"},{"id":"library:why-we-forget:3","max":120,"min":20,"q":"How will you study new English words after reading this text?"}],"source":{"license":"written for Slovar","name":"Slovar (an original article)","note":"based on H. Ebbinghaus, Memory (1885); N. Cepeda et al., Psychological Bulletin (2006); H. Roediger and J. Karpicke, Psychological Science (2006)"},"subtitle":"You learn a word today and lose it by next week. A scientist found out why more than a hundred years ago.","title":"Why We Forget New Words","topic":"psychology","words":293}
